{
  "name": "codex-usage-details",
  "private": true,
  "version": "0.1.3",
  "description": "A desktop dashboard for official Codex API and subscription usage.",
  "author": "Fukaki-Ato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fukaki-Ato/Codex-Usage-Details.git"
  },
  "homepage": "https://github.com/Fukaki-Ato/Codex-Usage-Details",
  "bugs": {
    "url": "https://github.com/Fukaki-Ato/Codex-Usage-Details/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "usage",
    "electron",
    "dashboard"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && electron-builder --win",
    "test": "node scripts/test.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stream-chain": "^4.4.2",
    "stream-json": "^3.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.7",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.fukakiato.codexusagedetails",
    "productName": "Codex Usage Details",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "icon": "build/usage-meter.ico",
    "win": {
      "target": "nsis",
      "icon": "build/usage-meter.ico"
    },
    "nsis": {
      "installerIcon": "build/usage-meter.ico",
      "uninstallerIcon": "build/usage-meter.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Usage Details",
      "perMachine": false
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}

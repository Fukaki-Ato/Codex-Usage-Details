{
  "name": "codex-usage-details",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop dashboard for official Codex API and subscription usage.",
  "author": "Fukaki-Ato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fukaki-Ato/Codex-Usage-Details.git"
  },
  "homepage": "https://github.com/Fukaki-Ato/Codex-Usage-Details",
  "bugs": {
    "url": "https://github.com/Fukaki-Ato/Codex-Usage-Details/issues"
  },
  "keywords": ["codex", "openai", "usage", "electron", "dashboard"],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && electron-builder --win",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.fukakiato.codexusagedetails",
    "productName": "Codex Usage Details",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "icon": "build/electron-default.png",
    "win": {
      "target": "nsis",
      "icon": "build/electron-default.png"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Usage Details",
      "perMachine": false
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
